{
  "name": "@quecto/test",
  "description": "Hyper-minimalist, zero-dependency concurrent test runner.",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "q-test": "bin/q-test.js"
  },
  "scripts": {
    "test": "node --test test/**.test.js",
    "lint": "eslint",
    "quecto": "node bin/q-test.js --register"
  },
  "exports": {
    ".": "./index.js",
    "./register": "./register.js"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
